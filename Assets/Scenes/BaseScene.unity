  dialogCommon:
  - {fileID: 1930121253}
  dialogCharacters:
  - {fileID: 1683367269}
  dialogText:
  - {fileID: 1022439064}
  - {fileID: 432466401}
  dialogsData:
  - character: 0
    text: How am i supposed to win the Championship without a track and a car...
  - character: 0
    text: Can you find the missing pieces of the track, and a car for me?
  - character: 0
    text: I promise you i'll help you if you do!
  - character: 0
    text: I only need 10 track pieces and 1 car
  - character: 0
    text: Thanks for finding the pieces of the track!
  - character: 0
    text: Well at least the car its better than the 2008th...
  - character: 0
    text: I will be on my way now, third Championship here I go!
  - character: 1
    text: Have you tried using the hammer on the library?
  - character: 1
    text: Maybe you can use the wood plank as a catapult with the little table in
      front of the tv...
  - character: 1
    text: for throwing things out the window
  - character: 1
    text: You can use the hammer on the mobile phone...
  - character: 1
    text: but you'll have to be precise
  isCinematicMode: 0
